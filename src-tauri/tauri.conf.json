{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rundown",
  "version": "0.1.0",
  "identifier": "com.kamrify.rundown",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rundown",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "An AI-native Hacker News client",
    "longDescription": "Read Hacker News threads, get grounded digests of what people actually argued, and ask follow-up questions using the Claude or Codex CLI already installed on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Qjg0QzgzQTJBODIyOEUKUldTT0lxaWlnMHk0cU1CcmRJVjZOSU0zZ0VvWXZzaFJYeTlCNWxGVnozZzJnUGF4Y1M1V1JGMmIK",
      "endpoints": [
        "https://github.com/nilbuild/rundown/releases/latest/download/latest.json"
      ]
    }
  }
}
